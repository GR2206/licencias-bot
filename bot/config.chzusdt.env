# =============================================================================
#  CONFIGURACION PARA CHZUSDT — H1 y M30
# =============================================================================
#  Copialo como config.env y completá las dos primeras líneas:
#
#      cp config.chzusdt.env config.env
#      nano config.env
#
#  config.env está en .gitignore: tus claves no se suben a ningún lado.
#
#  Viene con ENTORNO=real y MODO=simulacion. Eso significa: lee el mercado real
#  y tu saldo real, pero NO manda ninguna orden. Es el modo para dejarlo unos
#  días y comparar lo que registra contra lo que ves en el gráfico.
#  La única línea que hace que empiece a operar de verdad es MODO=real.
#
#  ANTES DE TOCAR ESA LÍNEA, el dato que corresponde: probado sobre 2.3 años de
#  CHZ real (117 operaciones en H1, 114 en M30) esta lógica da NEGATIVO, con una
#  peor racha de -22.8R en H1. Y no es cuestión de afinar: de 432 combinaciones
#  de parámetros, sólo el 22% queda positiva en las dos temporalidades, cuando
#  el azar puro daría ~25%. Está todo en el README.
#  Como herramienta para mirar el gráfico y decidir a mano, sirve. Como piloto
#  automático con plata real, la evidencia dice que no.
# =============================================================================

# ── 1. Tus claves ────────────────────────────────────────────────────────────
# Binance > API Management > Create API.
# Permisos: SOLO "Enable Futures". NUNCA habilites retiros.
# Si podés, restringí por IP (aunque en un celular la IP cambia seguido).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── 2. Dónde y cómo ──────────────────────────────────────────────────────────
# testnet | real
ENTORNO=real

# simulacion = solo registra en bot.log lo que haría
# real       = manda órdenes de verdad
MODO=simulacion

SIMBOLOS=CHZUSDT
TEMPORALIDADES=1h,30m

# ── 3. Riesgo de la cuenta ───────────────────────────────────────────────────
# Cuánto de la cuenta se pierde si salta el stop. Empezá en 0.5 y no pases de 2.
RIESGO_PCT=0.5

# No cambia el riesgo (eso lo define el stop), solo el margen retenido.
APALANCAMIENTO=5

MAX_POSICIONES=1

# Saldo que asume en simulación cuando no hay claves cargadas.
SALDO_SIMULADO=1000

# ── 4. Funcionamiento ────────────────────────────────────────────────────────
INTERVALO_SEGUNDOS=30

# Velas que pide en cada ciclo. 1500 es el maximo que da Binance y es a proposito:
# si la ventana es corta, un Order Block viejo queda afuera y el bot no lo ve, o
# sea que opera distinto a lo que se probo. Medido en CHZ 30m: con 500 velas se
# perdia 1 de cada 8 señales. Con 1500 coincide al 100%.
VELAS=1500

# ── 5. Estrategia ────────────────────────────────────────────────────────────
# Cualquier campo de estrategia.Config se puede pisar acá, en MAYUSCULAS.

# Objetivo final en múltiplos del riesgo. Es el único parámetro que en las
# pruebas mejoró de forma consistente al agrandarlo: 1:2 daba -0.032R por
# operación, 1:3 da -0.014R y 1:4 da +0.030R, positivo en H1 y en M30. Va en 3
# porque es lo que pediste, pero probá 4.
RR=3

# Cierra la mitad en 1R y mueve el stop a la entrada. Sube el porcentaje de
# aciertos y suaviza la curva, pero le corta la mitad a las operaciones que se
# van 4R o más, que son las que pagan todo. En el promedio se cancela.
PARCIAL_1R=true

# CHZ es volátil: sus stops quedan anchos (2 a 3% del precio es normal). Con el
# tope por defecto de 3% se descartaba la mitad de las señales, así que acá va
# en 5%. OJO: esto NO aumenta el riesgo de la cuenta, ese lo fija RIESGO_PCT.
# Un stop más ancho simplemente da una posición más chica.
RIESGO_MAX_PCT=5
RIESGO_MIN_PCT=0.3

# Motor de tendencia (SuperTrend). Más alto = menos señales y más tendencia.
FACTOR=2.6
ATR_PERIODO=14

# Estructura y Order Blocks.
PIVOTE=5
ORIGEN_MAX=12
DESPLAZAMIENTO_ATR=1.5
EXIGIR_FVG=true
MITIGAR_POR_CIERRE=true

# Velas de vida de un bloque antes de caducar. En 0 no caducan nunca, y un
# bloque de hace 900 velas ya no es una zona valida: además de operar viejo,
# hace que el vivo no coincida con el backtest. 250 velas = ~5 dias en M30.
EDAD_MAX_BLOQUE=250

# El precio tiene que haberse alejado 1 ATR del bloque antes de volver.
ALEJARSE_ATR=1.0

# La vela que entra en la zona tiene que cerrar a favor.
# ninguna | vela | cierre_fuera
CONFIRMACION=vela

# Stop: "atr" usa el borde del bloque o 1.5 ATR, el que quede más lejos.
SL_MODO=atr
SL_ATR=1.5

# Filtros de tendencia extra. La EMA 200 mejora en M30 y empeora en H1, o sea
# que no hay un lado claro: queda apagada, que es la version mas simple.
USAR_EMA=false
EMA_PERIODO=200
USAR_RSI=true
RSI_PERIODO=14

# Velas de espera entre entradas.
ESPERA_VELAS=5
