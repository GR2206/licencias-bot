# Copiá este archivo como config.env y completá tus datos.
#   cp config.example.env config.env
#
# config.env NO se sube a git (está en .gitignore). Tus claves son tuyas.

# ── Claves de API ────────────────────────────────────────────────────────────
# Testnet (gratis, plata de juguete): https://testnet.binancefuture.com
# Real: Binance > API Management. Habilitá SOLO "Futuros".
# NUNCA habilites retiros. Si podés, restringí por IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Donde opera ──────────────────────────────────────────────────────────────
# testnet | real
ENTORNO=testnet

# simulacion = solo escribe en el log lo que haría (no manda nada)
# real       = manda órdenes de verdad
MODO=simulacion

# ── Qué opera ────────────────────────────────────────────────────────────────
SIMBOLOS=BTCUSDT,ETHUSDT
TEMPORALIDADES=1h,30m

# ── Riesgo ───────────────────────────────────────────────────────────────────
# % de la cuenta que se pierde si salta el stop. 1 o 2 es sensato. 10 es un
# suicidio con pasos extra.
RIESGO_PCT=1

# El apalancamiento NO cambia el riesgo (eso lo define el stop), solo el margen
# que Binance te retiene. Con x5 alcanza.
APALANCAMIENTO=5

# Posiciones abiertas a la vez como máximo.
MAX_POSICIONES=2

# Saldo que asume en simulación cuando no hay claves cargadas.
SALDO_SIMULADO=1000

# ── Funcionamiento ───────────────────────────────────────────────────────────
# Cada cuántos segundos revisa. 30 está bien para H1 y M30.
INTERVALO_SEGUNDOS=30

# Velas de historia que baja para calcular. 1500 es el máximo de Binance.
# Si la ventana es más corta que la vida de un Order Block, el bot no ve ese
# bloque y opera distinto a lo que se probó. El bot avisa al arrancar si el
# número no da. No bajes de 500.
VELAS=1500

# ── Estrategia ───────────────────────────────────────────────────────────────
# Cualquier campo de estrategia.Config se puede pisar acá, en MAYUSCULAS.
# Los que más se tocan:

# Relación riesgo/beneficio del objetivo final.
RR=3

# Cierra la mitad en 1R y mueve el stop a la entrada.
PARCIAL_1R=true

# Velas de vida de un Order Block. En 0 no caducan nunca.
EDAD_MAX_BLOQUE=250

# Distancia máxima al stop, en % del precio. Las señales con el stop más lejos
# se descartan. No es el riesgo de la cuenta (ese es RIESGO_PCT): con monedas
# volátiles como CHZ conviene subirlo a 5, si no se descarta media señal.
RIESGO_MAX_PCT=3

# Ver config.chzusdt.env para la lista completa con explicación de cada uno.
