# ============================================================================
#  PRESET: LA LINEA GRIS  (martillo en la EMA 200 + ruptura)
# ============================================================================
#  Copialo a config.env y completa las claves:
#      cp config.linea_gris.env config.env
#
#  QUE ES: la regla de la linea gris del grafico. Largo cuando el precio rebota
#  en la EMA 200 con una vela martillo, corto cuando la pasa de largo.
#
#  QUE DIO AL MEDIRLO (25 activos de Binance, 1 anio real de M15+M30+H1, con
#  comisiones, eligiendo parametros en 8 activos y verificando en los otros 17):
#
#      SHORT por ruptura ...... +0.08 R por operacion   (3586 operaciones)
#      LONG por martillo ...... -0.11 R por operacion   ( 194 operaciones)
#
#  Y POR QUE ARRANCA EN SIMULACION igual:
#
#    1. Ese anio 23 de los 25 activos BAJARON, mediana -56%. La misma regla al
#       alza da -0.18 R. En ZEC, el unico que subio fuerte, se invierte y gana
#       el largo. Lo medido puede ser el mercado y no la regla.
#    2. Toda la ventaja cabe dentro de los costos: +0.07 R como esta, +0.01 R
#       con 0.05% de slippage por lado, negativa pagando taker en todo.
#    3. Se apaga con el tiempo: +0.15 R en la primera mitad del anio y -0.01 R
#       en la segunda.
#
#  Dejalo dos semanas en simulacion y compara con estos numeros antes de
#  siquiera pensar en pasarlo a real.
# ============================================================================

ESTRATEGIA=linea_gris

ENTORNO=real
MODO=simulacion

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Los 8 activos que dieron positivo en las DOS mitades del anio, todos muy
# liquidos (lo unico que de verdad importa para que el precio de entrada se
# parezca al del backtest).
#
# Esta canasta, en M15+H1 sobre el anio entero y con comisiones, dio:
#
#     1102 operaciones = 3.0 por dia   <- justo el ritmo que buscabas
#     +0.29 R por operacion, 27% de acierto
#     peor caida -37 R (con RIESGO_PCT=0.25 son ~9% de la cuenta)
#     peor racha: 21 operaciones perdidas seguidas
#
# LEE ESTO ANTES DE ENTUSIASMARTE: ese +0.29 R esta inflado, porque los 8
# activos se eligieron mirando este mismo anio. El numero limpio es el de los 17
# activos que NO se usaron para elegir: +0.08 R por operacion. Y hasta ese
# depende de que el mercado siga cayendo. Las 21 perdidas seguidas, en cambio,
# son reales y te van a pasar.
SIMBOLOS=ADAUSDT,XLMUSDT,XRPUSDT,WLDUSDT,SOLUSDT,ENAUSDT,DOGEUSDT,ZECUSDT

# M15 y H1 fueron las dos mejores (+0.10 R cada una). M30 quedo en +0.03 R.
TEMPORALIDADES=15m,1h

# Riesgo por operacion. Con 8 simbolos en 2 temporalidades pueden abrirse varias
# a la vez, por eso el tope de riesgo total.
RIESGO_PCT=0.25
MAX_POSICIONES=3
RIESGO_MAX_TOTAL_PCT=1.5
APALANCAMIENTO=5

# 1500 velas cubren la EMA 200 con margen de sobra en cualquier temporalidad.
VELAS=1500
INTERVALO=20
PAUSA_PEDIDOS=0.25
SALDO_SIMULADO=1000

# ── Parametros de la estrategia ──────────────────────────────────────────────
EMA_PERIODO=200
RR=4

# El piso de stop es EL parametro que movio el resultado: de -0.07 R a +0.07 R
# por operacion. La comision es un porcentaje del nocional, asi que sobre un
# stop del 0.2% se lleva 0.35 R y sobre uno del 1.5% apenas 0.05 R. Las senales
# con el stop muy pegado pierden por aritmetica, no por mala suerte.
RIESGO_MIN_PCT=1.0
RIESGO_MAX_PCT=3.0

USAR_MARTILLO=true
USAR_RUPTURA=true
# El espejo al alza dio -0.18 R. Encendelo solo para mirar, no para operar.
RUPTURA_LARGO=false

ESPERA_VELAS=3
PARCIAL_1R=false
