# =============================================================================
#  SCALPING DE IMPULSO — tendencia M15, entrada por imbalance en M5
# =============================================================================
#  LEE ESTO ANTES DE USARLO. Es la configuracion que mide la idea del scalping
#  de 5 minutos, y lo que midio es que en Binance esa idea no cierra por
#  aritmetica, no por como esta programada.
#
#  ── LA CUENTA QUE LO DECIDE ─────────────────────────────────────────────────
#
#  Un trade de 5 minutos captura, como maximo, lo que el activo se mueve en 5
#  minutos. Medido sobre velas reales de M1 (mediana del recorrido de 5 velas):
#
#      BTCUSDT  0.099%      DOGEUSDT 0.209%
#      ETHUSDT  0.136%      XRPUSDT  0.213%
#      SOLUSDT  0.196%      ADAUSDT  0.273%
#
#  La comision de Binance futuros a mercado es 0.10% del nocional ida y vuelta.
#  O sea que en BTC la comision es igual a TODO lo que el precio se mueve en 5
#  minutos. Si el stop es la mitad de ese recorrido (0.049%), la comision vale
#  2.02 R: pagas dos veces tu riesgo por el derecho a jugar.
#
#  El acierto que hace falta solo para no perder plata, con objetivo 1:2:
#
#      BTCUSDT  100.7%  (imposible)     DOGEUSDT  65.2%
#      ETHUSDT   82.5%                  XRPUSDT   64.6%
#      SOLUSDT   67.4%                  ADAUSDT   57.7%
#
#  Y el techo de lo alcanzable, medido entrando AL AZAR en el mismo activo con
#  el mismo stop, es 33.3%. No 60%, no 85%: 33.3%, porque en un paseo aleatorio
#  la probabilidad de tocar +2X antes de -X es 1/3 exacto. Falta un abismo.
#
#  ── QUE PASA SI RESPETAS EL COSTO ───────────────────────────────────────────
#
#  Por eso el piso de stop de aca abajo. Con COSTO_IDA_VUELTA_PCT=0.10 y
#  COSTO_MAX_R=0.15, el stop no puede bajar de 0.667% del precio. Eso arregla el
#  problema del costo y crea otro: un stop de 0.667% con objetivo de 1.33% no se
#  resuelve en 5 minutos. Medido en 60-90 dias de M5:
#
#      activo     ops  op/dia   acierto   vs azar    R/op   como salio
#      BTCUSDT      8    0.09     25.0%    -2.4pp   -0.515  0 al objetivo
#      ETHUSDT     11    0.12     45.5%   +15.1pp   -0.109  0 al objetivo
#      SOLUSDT     19    0.21     42.1%    +7.8pp   -0.047  1 al objetivo
#      DOGEUSDT    20    0.22     45.0%   +11.9pp   -0.208  1 al objetivo
#      XRPUSDT     14    0.16     28.6%    -4.4pp   -0.189  1 al objetivo
#      ADAUSDT     40    0.44     32.5%    -5.2pp   -0.337  1 al objetivo
#
#  De 112 operaciones, 5 llegaron al objetivo. El resto salio por tiempo o por
#  stop. Y 0.09 a 0.44 operaciones por dia, cuando querias 3 a 5.
#
#  Las dos condiciones que pediste — "que no dure mas de 5 minutos" y "en
#  Binance" — se contradicen entre si. No es un problema de afinar parametros.
#
#  ── DONDE SI DA LA CUENTA ───────────────────────────────────────────────────
#
#  El mismo calculo en otros mercados, con el costo de cada uno:
#
#      mercado / activo           mueve 5m   costo    en R   acierto 1:3
#      Oro en Exness Standard       0.100%   0.015%   0.30R      32.5%
#      Plata en Exness Standard     0.164%   0.015%   0.18R      29.6%
#      Oro en Exness Raw            0.100%   0.008%   0.16R      29.0%
#      S&P 500                      0.053%   0.015%   0.57R      39.3%
#      EURUSD                       0.012%   0.015%   2.58R      89.5%
#
#  El oro y la plata son los unicos donde el scalping de 5 minutos es
#  ARITMETICAMENTE posible: hacen falta 29-33% de acierto y el azar da 25-33%.
#  EURUSD es lo peor de todo, al revés de lo que todos suponen, porque se mueve
#  1.4 pips en 5 minutos y el spread es 1 pip.
#
#  Pero posible no es lo mismo que rentable. La estrategia probada en oro M5, en
#  96 configuraciones distintas: 90 aciertan MENOS que entrar al azar. Ver
#  metatrader/ para el mismo calculo con el EA.
#
#  ── COMO USAR ESTE ARCHIVO ─────────────────────────────────────────────────
#
#  Con MODO=simulacion, y sobre todo con el panel:
#
#      ESTRATEGIA=scalper python panel.py
#
#  El panel tiene un boton "medir" que compara cualquier configuracion contra
#  entrar al azar. Es la herramienta mas util del proyecto: usala antes de
#  creerle a cualquier idea, incluida esta.
# =============================================================================

ENTORNO=real
MODO=simulacion

BINANCE_API_KEY=
BINANCE_API_SECRET=

ESTRATEGIA=scalper

# Los mas volatiles en relacion al costo. BTC y ETH quedan afuera a proposito:
# se mueven demasiado poco en 5 minutos para lo que cuesta operarlos.
SIMBOLOS=ADAUSDT,DOGEUSDT,XRPUSDT,SOLUSDT
TEMPORALIDADES=5m

# 17280 velas de M5 son 60 dias. Hace falta historia para que el piso de stop
# encuentre algo y para que la medicion signifique algo.
VELAS=1500

SALDO_SIMULADO=1000
RIESGO_PCT=0.5
MAX_POSICIONES=2
APALANCAMIENTO=5

# ── La estrategia ────────────────────────────────────────────────────────────
FACTOR_MAYOR=3            # 3 velas de M5 = tendencia de M15
EMA_RAPIDA=20
EMA_LENTA=50
EXIGIR_PENDIENTE=true

IMPULSO_ATR=1.5           # rango de la vela mayor a esto x ATR
EXIGIR_FVG=true           # exigir el hueco de 3 velas (imbalance)
ESPERA_MAX=12             # velas que el hueco queda vivo
TOQUE_FRACCION=1.0        # 1.0 = esperar el borde lejano del hueco
EXIGIR_CONFIRMACION=true

RR=2                      # un acierto recupera 2 perdidas, como pediste
COLCHON_ATR=1.2
MINUTOS_MAX=30            # salida por tiempo. Con 5 no llega nada al objetivo.
ESPERA_VELAS=2

# ── El costo, que es lo que manda ────────────────────────────────────────────
# De estos dos numeros sale el piso del stop: costo / costo_max_r.
# Binance a mercado son 0.05% por lado, o sea 0.10% ida y vuelta.
COSTO_IDA_VUELTA_PCT=0.10
COSTO_MAX_R=0.15          # cuanto de 1 R aceptas regalarle a la comision
RIESGO_MAX_PCT=1.5        # tiene que quedar ARRIBA del piso (0.667%)

# ── Horario en hora UTC. 0 y 24 = todo el dia ────────────────────────────────
HORA_DESDE=0
HORA_HASTA=24
