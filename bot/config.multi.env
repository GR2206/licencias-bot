# =============================================================================
#  CANASTA DE 8 ACTIVOS EN M15 — apunta a 3-5 operaciones por dia
# =============================================================================
#  Copialo como config.env y completá las dos claves:
#
#      cp config.multi.env config.env
#      nano config.env
#
#  Esto responde a tres pedidos concretos: stops mas cortos, varios activos y
#  3-5 operaciones por dia. Los tres se cumplen. Medido sobre un anio de historia
#  real de Binance con estos 8 activos en M15: 3.96 operaciones por dia y stop
#  promedio de 1.13% del precio (antes eran 2.5-3%).
#
#  LO QUE NO SE CUMPLE es que gane. Ese mismo anio da -0.047R por operacion. A
#  4 operaciones por dia son ~1460 al anio, o sea unas -68R: con RIESGO_PCT=0.25
#  es -17% de la cuenta al anio, y con caidas de -280R en la cartera completa.
#  Mas operaciones con esperanza negativa no es mas efectividad: es perder mas
#  rapido. Por eso viene en MODO=simulacion.
#
#  El detalle de como se midio esta en el README, seccion "Recorrido por 25
#  activos". Resumen: 384 configuraciones probadas, 3% dan positivo en los
#  activos que no se usaron para elegirlas.
# =============================================================================

# ── 1. Tus claves ────────────────────────────────────────────────────────────
# Binance > API Management. Permisos: SOLO "Enable Futures". Nunca retiros.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── 2. Dónde y cómo ──────────────────────────────────────────────────────────
ENTORNO=real
MODO=simulacion

# Los 8 perpetuos mas liquidos de Binance. Elegidos por liquidez, no por
# resultado pasado: el analisis mostro que el activo que rindio bien en un
# semestre no rinde mejor en el siguiente, mientras que la liquidez si predice
# algo real (menos spread y menos slippage).
SIMBOLOS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT

# M15 sola. Con estos 8 activos da ~4 operaciones por dia. Si agregás 30m sumás
# ~2 mas por dia. En H1 son 0.1 por dia por activo: no llega ni cerca de 3.
TEMPORALIDADES=15m

# ── 3. Riesgo de la cuenta ───────────────────────────────────────────────────
# Mas chico que en un solo activo a proposito: con 4 operaciones por dia y
# hasta 3 abiertas a la vez, 0.25% por operacion ya son 1% del capital en riesgo
# en un dia normal.
RIESGO_PCT=0.25

APALANCAMIENTO=5
MAX_POSICIONES=3
SALDO_SIMULADO=1000

# ── 4. Funcionamiento ────────────────────────────────────────────────────────
# El bot revisa una sola vez por vela cerrada, asi que con 15 segundos entra
# enseguida despues de cada cierre sin gastar pedidos al aire.
INTERVALO_SEGUNDOS=15
PAUSA_PEDIDOS=0.15

# 500 velas alcanzan porque los bloques caducan a las 250. Con 8 simbolos son
# 16 de peso por barrido, contra un limite de 2400 por minuto.
VELAS=500

# ── 5. Estrategia: la version de stop corto ──────────────────────────────────
# Este es el cambio que pediste. NO se logra moviendo el stop mas cerca (probado:
# empeora, porque la comision es un % fijo del nocional y sobre un stop del 0.3%
# se come 0.3R por operacion). Se logra DESCARTANDO los setups cuyo stop nace
# largo. Con el tope en 1.8% el stop promedio queda en 1.13% en vez de 2.5-3%,
# y el resultado por operacion no empeora.
RIESGO_MAX_PCT=1.8
RIESGO_MIN_PCT=0.2

# Objetivo lejano. En el barrido de 384 configuraciones fue el unico parametro
# con direccion consistente: rr 2 peor que rr 3, rr 3 peor que rr 4.
RR=4

# Apagada: con objetivo en 4R hay que dejar correr, si no se corta justo las
# pocas operaciones que pagan el resto.
PARCIAL_1R=false

# Estructura mas corta (pivote 3) porque en M15 el pivote de 5 velas deja pasar
# casi todo el movimiento.
PIVOTE=3
FACTOR=2.0
ATR_PERIODO=14
ORIGEN_MAX=12
DESPLAZAMIENTO_ATR=1.5
EXIGIR_FVG=true
MITIGAR_POR_CIERRE=true
EDAD_MAX_BLOQUE=250
ALEJARSE_ATR=1.0
CONFIRMACION=vela
SL_MODO=atr
SL_ATR=1.5
USAR_EMA=false
USAR_RSI=true
ESPERA_VELAS=5
